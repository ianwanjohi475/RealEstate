# ============================================================
# Esto server environment — copy this file to ".env" and fill in.
# ".env" is git-ignored so your real keys never reach GitHub.
# ============================================================

PORT=5000

# --- Database (MongoDB Atlas or local) ---
# e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/esto?retryWrites=true&w=majority
MONGODB_URI=
# Secret used to sign login tokens — set any long random string:
JWT_SECRET=change-this-to-a-long-random-string
# Default password for the seeded demo agent accounts (so you can log in as an agent):
AGENT_PASSWORD=agent123

# --- M-Pesa Daraja ---
# "sandbox" for testing, "production" when you go live
MPESA_ENV=sandbox
# Paste the Consumer Key / Secret from your Daraja app here (in .env, not here):
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
# Sandbox till/shortcode + public test passkey (defaults work for sandbox):
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# A publicly reachable HTTPS URL Daraja can POST results to (use ngrok in dev):
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback

# --- Contact email (optional; leave blank to just log enquiries) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=ianwanjohi475@gmail.com
